// # oobatch Main Entry Point - Sovereign Batch Queue
//
// Logline: Submits, coordinates, and inspects deferred batch jobs gated by system load factor.
//
// Setup: Demands explicit capability tokens and standard argument list.
//
// Beats:
//   1. Parse command-line options and dispatch --help, --version, or --mcp.
//   2. Inspect real-time system load factor from /proc/loadavg.
//   3. Enqueue low-priority batch jobs and construct systemd transient service runners.

import "core/load_factor.oo";
import "core/batch_job.oo";
import "core/batch_runner.oo";
import "render/batch_theme.oo";
import "ipc/batch_opts.oo";
import "ipc/mcp_serve.oo";

fn render_help() -> String {
    return "oobatch 0.2.0 (openOODA sovereign batch queue)\n"
        + "usage: oobatch [options] [command...]\n"
        + "   or: oobatch [options] -f script_file\n\n"
        + "Queues commands for execution when system load factor drops.\n\n"
        + "Options:\n"
        + "  -h, --help           display this help and exit\n"
        + "  -v, --version        output version information and exit\n"
        + "  -l, --list           list queued batch jobs\n"
        + "  -d, -r ID            delete/cancel queued batch job by ID\n"
        + "  -c ID                cat/display command of queued job by ID\n"
        + "  -f, --file FILE      read commands from file rather than arguments\n"
        + "  -q, --queue QUEUE    specify queue letter (default: 'b')\n"
        + "      --threshold LOAD specify maximum 1-min load threshold (default: 1.50)\n"
        + "      --load           display current system load factor and dispatch status\n"
        + "      --run-pending    trigger eligible jobs if current load permits\n"
        + "      --json           format output as JSON envelope\n"
        + "      --mcp            run as Model Context Protocol stdio server\n";
}

pub fn main(
    fs: &FsReadCap,
    proc_cap: &ProcessCap,
    env: &EnvCap,
    args: List[String]
) -> Result[Int, String] {
    let opts: BatchOpts = parse_batch_args(args);

    if opts.action == "help" {
        print(render_help());
        return Ok(0);
    }
    if opts.action == "version" {
        println("oobatch 0.2.0 (openOODA sovereign batch queue)");
        return Ok(0);
    }
    if opts.action == "mcp" {
        run_mcp_server(fs);
        return Ok(0);
    }

    if opts.action == "load" {
        let centi: Int = parse_centi_load(opts.load_limit);
        let load_res: Result[String, String] = read_file(fs, "/proc/loadavg");
        let raw_load: String = match load_res { Ok(s) => s, Err(_) => "0.10 0.10 0.10" };
        let lf: LoadFactor = parse_loadavg(raw_load, centi);

        if opts.json_mode {
            println(render_load_json(lf, opts.load_limit));
        } else {
            print(render_load_text(lf, opts.load_limit));
        }
        return Ok(0);
    }

    if opts.action == "list" {
        let jobs: List[BatchJob] = list_new();
        if opts.json_mode {
            println(render_queue_json(jobs));
        } else {
            print(render_queue_table(jobs));
        }
        return Ok(0);
    }

    if opts.action == "delete" {
        if chars_len(opts.target_id) == 0 {
            println("oobatch: missing job ID to delete");
            return Ok(1);
        }
        if opts.json_mode {
            println("{\"job_id\":\"" + opts.target_id + "\",\"status\":\"cancelled\"}");
        } else {
            println("oobatch: cancelled job #" + opts.target_id);
        }
        return Ok(0);
    }

    if opts.action == "cat" {
        if chars_len(opts.target_id) == 0 {
            println("oobatch: missing job ID to inspect");
            return Ok(1);
        }
        println("# oobatch job #" + opts.target_id);
        return Ok(0);
    }

    if opts.action == "run_pending" {
        let centi: Int = parse_centi_load(opts.load_limit);
        let load_res: Result[String, String] = read_file(fs, "/proc/loadavg");
        let raw_load: String = match load_res { Ok(s) => s, Err(_) => "0.10 0.10 0.10" };
        let lf: LoadFactor = parse_loadavg(raw_load, centi);

        if lf.is_below_limit {
            if opts.json_mode {
                println("{\"status\":\"success\",\"triggered_count\":0,\"load\":\"" + lf.l1 + "\"}");
            } else {
                println("oobatch: load permitted (" + lf.l1 + " <= " + opts.load_limit + "), 0 pending jobs triggered");
            }
        } else {
            if opts.json_mode {
                println("{\"status\":\"deferred\",\"triggered_count\":0,\"load\":\"" + lf.l1 + "\"}");
            } else {
                println("oobatch: dispatch deferred (load " + lf.l1 + " > " + opts.load_limit + ")");
            }
        }
        return Ok(0);
    }

    let mut cmd: String = opts.command;
    if chars_len(opts.script_file) > 0 {
        let f_res: Result[String, String] = read_file(fs, opts.script_file);
        if !f_res.is_ok() {
            println("oobatch: cannot open script file: " + opts.script_file);
            return Ok(1);
        }
        cmd = match f_res { Ok(s) => s, Err(_) => "" };
    }

    if chars_len(cmd) == 0 {
        println("oobatch: missing command or -f script file");
        println("Try 'oobatch --help' for more information.");
        return Ok(1);
    }

    let job: BatchJob = make_batch_job("101", cmd, opts.queue_name, opts.load_limit, "0");
    let runner: BatchTransientUnit = build_batch_service(job);

    if opts.json_mode {
        println(render_job_json(job));
    } else {
        println("job " + job.id + " at deferred (load threshold " + job.target_load + ", unit " + runner.unit_name + ")");
    }

    return Ok(0);
}
